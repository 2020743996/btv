<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml：安卓软件的总说明书
     声明了软件叫什么、有哪些页面（Activity）、需要什么权限 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网权限：下载 M3U 文件和播放直播流都需要 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- TV 没有触摸屏；这两项让应用可被 Android TV 商店正确识别。 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.IptvPlayer"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic：允许 http:// 明文地址。
            很多 IPTV 源（M3U/直播流）是明文 http，安卓 9+ 默认禁止，
            不打开会导致这类源全部下载失败 -->

        <!-- MainActivity：频道列表页，软件启动后显示的第一个页面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <!-- LAUNCHER：在手机/盒子的应用列表里显示 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- LEANBACK_LAUNCHER：让安卓 TV 系统知道这是 TV 软件 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- PlayerActivity：播放页面（沉浸式全屏，配置变化不重建避免打断播放） -->
        <activity
            android:name=".PlayerActivity"
            android:theme="@style/Theme.IptvPlayer.Playback"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!-- SettingsActivity：M3U 地址设置页面 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- SearchActivity：频道搜索页面 -->
        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <!-- AdminActivity：管理员模式（源地址、日志、失效管理） -->
        <activity
            android:name=".AdminActivity"
            android:exported="false" />
        <activity
            android:name=".AddressActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DeadChannelActivity"
            android:exported="false" />
        <activity
            android:name=".LogActivity"
            android:exported="false" />
    </application>

</manifest>
